# ---------- Database ----------
POSTGRES_USER=recoverai
POSTGRES_PASSWORD=recoverai
POSTGRES_DB=recoverai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://recoverai:recoverai@localhost:5433/recoverai

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# ---------- AI ----------
# Modes: auto (LLM with budget + heuristic fallback) | llm | heuristic
AI_MODE=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_CONCURRENCY=8
# Max LLM calls per simulation run; remainder served from decision cache / heuristic
AI_LLM_BUDGET_PER_RUN=150

# ---------- Customer messaging (WhatsApp / SMS via Twilio) ----------
# Off by default: with MESSAGING_ENABLED=false, messages are still composed, recorded
# and shown in the UI, but nothing leaves the machine.
MESSAGING_ENABLED=false
MESSAGING_PREFERRED_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ---------- Razorpay (TEST MODE ONLY) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false

# ---------- Policy defaults ----------
POLICY_MAX_ATTEMPTS=3
POLICY_MAX_NOTIFICATIONS=2
POLICY_COOLDOWN_MINUTES=0
POLICY_MAX_DISCOUNT_MINOR=100000
POLICY_OPPORTUNITY_TTL_HOURS=168
